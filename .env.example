# ── Discord ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Comma-separated list of Discord user IDs allowed to run commands
ADMIN_DISCORD_USER_IDS=123456789012345678,987654321098765432

# ── API ──────────────────────────────────────────────────
# Internal API key shared between bot, API, and workers.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace_with_a_secure_random_key

# URL of the export API (internal Docker network)
EXPORT_API_URL=http://export-api:8080

# ── Workers ──────────────────────────────────────────────
# Discord user token for extraction workers (NOT the bot token).
# Used by DiscordChatExporter and member scraper.
DISCORD_USER_TOKEN=

# ── Server ───────────────────────────────────────────────
# Host and port for the export API (inside container)
API_HOST=0.0.0.0
API_PORT=8080

# ── Data ─────────────────────────────────────────────────
DATA_ROOT=/data
